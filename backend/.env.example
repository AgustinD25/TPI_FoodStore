# Copiar este archivo como .env y completar los valores. El .env no se entrega ni se sube.

# Base de datos. PostgreSQL (si la contraseña tiene @ : / # % hay que codificarlos, por ejemplo @ -> %40):
DATABASE_URL=postgresql://postgres:completar@localhost:5432/foodstore_db
# Para desarrollo local sin PostgreSQL se acepta SQLite:
# DATABASE_URL=sqlite:///./foodstore.db

# Firma del JWT: al menos 32 caracteres aleatorios.
# Para generarla: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=completar-una-clave-de-al-menos-32-caracteres
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Origen del frontend permitido por CORS (con credenciales)
FRONTEND_ORIGIN=http://localhost:5173
